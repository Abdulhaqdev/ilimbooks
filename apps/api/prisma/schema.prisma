generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Admin panelda almashtiriladigan akkaunt (har biri o'z marketlari, landinglari va analitikasi bilan).
model Account {
  code      String   @id
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// CPA market (ShoxMarket, Amiram, ...) — lead shu API'ga uzatiladi.
/// Barcha "AliTrend" tizimidagi marketlar bir xil shaklda: api_key + stream + offer_id.
model Market {
  id             String   @id @default(cuid())
  account        String
  code           String
  name           String
  endpoint       String   @default("")
  apiKey         String   @default("")
  defaultStream  String   @default("")
  defaultOfferId String   @default("")
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([account, code])
  @@index([account])
}

model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Session {
  id          String   @id @default(cuid())
  sid         String   @unique
  page        String   @default("/")
  account     String   @default("nazir")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  referrer    String?
  ua          String?
  device      String?
  browser     String?
  os          String?
  maxScroll   Int      @default(0)
  dwellMs     Int      @default(0)
  converted   Boolean  @default(false)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  events      Event[]

  @@index([lastSeen])
  @@index([firstSeen])
  @@index([converted])
  @@index([utmContent])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([account])
}

model Event {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  elId      String?
  elText    String?
  scrollPct Int?
  dwellMs   Int?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}

/// Admin paneldan boshqariladigan landing sahifa. slug "" — bosh sahifa (/).
model Landing {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  template    String   @default("full")
  active      Boolean  @default(true)
  content     Json
  pixelId     String   @default("")
  /// Qaysi akkauntga tegishli (Account.code)
  account     String   @default("nazir")
  /// Lead qaysi marketga ketadi (Market.id). Bo'sh — akkauntning birinchi faol marketi.
  marketId    String?
  /// Market oqimi (stream kaliti) — bo'sh bo'lsa market standarti
  stream      String   @default("")
  /// Market mahsulot raqami (offer_id) — bo'sh bo'lsa market standarti
  offerId     String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([account])
}

/// Landingdan kelgan buyurtma (ism + telefon). ShoxMarket API'ga yuboriladi.
model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  account     String   @default("nazir")
  marketId    String?
  /// Uzatilgan market nomi (tarix uchun, market o'chirilsa ham qoladi)
  marketName  String?
  offerId     String?
  stream      String?
  status      String   @default("new") // new | sent | failed
  shoxOk      Boolean  @default(false)
  shoxId      String?
  shoxMessage String?
  sid         String?
  /// Tashrif buyuruvchi (httpOnly cookie) — buyurtmalar limitini hisoblash uchun
  vid         String?
  page        String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  referrer    String?
  ua          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([phone])
  @@index([vid])
  @@index([account])
}
