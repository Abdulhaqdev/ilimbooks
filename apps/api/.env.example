DATABASE_URL="postgresql://ilimbooks:ilimbooks@localhost:5432/ilimbooks?schema=public"
JWT_SECRET="dev-jwt-secret-change-in-production"
ADMIN_USER="admin"
ADMIN_PASSWORD="ChangeMeNow!2026"
LANDING_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"
PORT=3040
NODE_ENV=development

# Market (CPA) kalitlari — faqat seed uchun. Keyin admin → Marketlar sahifasida boshqariladi.
# ShoxMarket (nazir akkaunti)
SHOX_API_KEY=
SHOX_STREAM=
SHOX_OFFER_ID=1
# Amiram (amiram akkaunti) — npm run prisma:seed:amiram uchun
AMIRAM_API_KEY=
AMIRAM_STREAM=

# Landing rasmlari saqlanadigan papka (deploy paytida o‘chirilmasin)
UPLOAD_DIR=

# Meta Conversions API (Events Manager → Settings → Conversions API → Generate token)
# Pixel ID admin paneldan (Sozlamalar) kiritiladi. CAPI ixtiyoriy.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
